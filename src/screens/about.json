                            "text": "{version}",
                            "size": "large",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "HW  {hw_ver}"
                        },
                        {
                            "text": "HMI {hmi_ver}"
                        },
                        {
                            "text": "OS  {os_ver}"
                        },
                        {
                            "text": "PM  {pm_ver}"
                        },
                        {
                            "text": "SN  {serial}"
