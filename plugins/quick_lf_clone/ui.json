{
    "plugin": true,
    "name": "Quick LF Clone",
    "version": "1.0.0",
    "i18n": {
        "zh": {
            "strings": {
                "Quick LF Clone": "低频快克隆",
                "Place source tag on reader": "请将源卡放到读头",
                "Press OK to scan": "按OK扫描",
                "Back": "返回",
                "Found: {tag_type}": "发现: {tag_type}",
                "ID: {tag_id}": "ID: {tag_id}",
                "Place blank T55xx, press OK": "放置空白T55xx后按OK",
                "Clone": "克隆",
                "Clone successful!": "克隆成功!",
                "{tag_type}: {tag_id}": "{tag_type}: {tag_id}",
                "Press OK to restart": "按OK重新开始",
                "Again": "再次",
                "Press OK to retry": "按OK重试"
            }
        }
    },
    "initial_state": "idle",
    "states": {
        "idle": {
            "screen": {
                "title": "Quick LF Clone",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Place source tag on reader", "size": "normal"},
                        {"text": ""},
                        {"text": "Press OK to scan", "size": "normal"}
                    ]
                },
                "buttons": {"left": "Back", "right": null},
                "keys": {
                    "OK": "run:do_scan",
                    "M1": "finish"
                }
            },
            "transitions": {
                "on_result.status==found": "found",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "found": {
            "screen": {
                "title": "Quick LF Clone",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Found: {tag_type}", "size": "normal"},
                        {"text": "ID: {tag_id}", "size": "normal"},
                        {"text": ""},
                        {"text": "Place blank T55xx, press OK", "size": "normal"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Clone"},
                "keys": {
                    "OK": "run:do_clone",
                    "M1": "finish"
                }
            },
            "transitions": {
                "on_result.status==done": "done",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "done": {
            "screen": {
                "title": "Quick LF Clone",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Clone successful!", "size": "large", "align": "center"},
                        {"text": ""},
                        {"text": "{tag_type}: {tag_id}", "size": "normal"},
                        {"text": ""},
                        {"text": "Press OK to restart", "size": "normal"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "set_state:idle",
                    "M1": "finish"
                }
            }
        },
        "error": {
            "screen": {
                "title": "Quick LF Clone",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "{error_msg}", "size": "normal"},
                        {"text": ""},
                        {"text": "Press OK to retry", "size": "normal"}
                    ]
                },
                "buttons": {"left": "Back", "right": null},
                "keys": {
                    "OK": "set_state:idle",
                    "M1": "finish"
                }
            }
        }
    }
}
