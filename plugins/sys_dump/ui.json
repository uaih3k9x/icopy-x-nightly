{
    "plugin": true,
    "name": "Diag Dump",
    "version": "1.1.0",
    "i18n": {
        "zh": {
            "strings": {
                "Diag Dump": "诊断导出",
                "Dump diagnostics to USB.": "导出诊断到U盘",
                "Shows NCM/IP/USB self-check first.": "先显示NCM/IP/USB自检",
                "Full dmesg and USB tree go to file.": "完整dmesg和USB树写入文件",
                "Press OK to collect.": "按OK收集",
                "Back": "返回",
                "Again": "再次",
                "Press OK to retry.": "按OK重试",
                "Retry": "重试"
            }
        }
    },
    "initial_state": "idle",
    "states": {
        "idle": {
            "screen": {
                "title": "Diag Dump",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Dump diagnostics to USB.", "size": "normal"},
                        {"text": ""},
                        {"text": "Shows NCM/IP/USB self-check first.", "size": "normal"},
                        {"text": "Full dmesg and USB tree go to file.", "size": "normal"},
                        {"text": ""},
                        {"text": "Press OK to collect.", "size": "normal"}
                    ]
                },
                "buttons": {"left": "Back", "right": null},
                "keys": {
                    "OK": "run:do_dump",
                    "M1": "finish"
                }
            },
            "transitions": {
                "on_result.status==done": "done",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "done": {
            "screen": {
                "title": "Diag Dump",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "{summary}", "size": "normal"}
                    ],
                    "scrollable": true
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "run:do_dump",
                    "M1": "finish",
                    "M2": "run:do_dump"
                }
            },
            "transitions": {
                "on_result.status==done": "done",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "error": {
            "screen": {
                "title": "Diag Dump",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "{error_msg}", "size": "normal"},
                        {"text": ""},
                        {"text": "Press OK to retry.", "size": "normal"}
                    ],
                    "scrollable": true
                },
                "buttons": {"left": "Back", "right": "Retry"},
                "keys": {
                    "OK": "set_state:idle",
                    "M1": "finish",
                    "M2": "set_state:idle"
                }
            }
        }
    }
}
