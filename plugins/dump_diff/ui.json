{
    "plugin": true,
    "name": "Dump Diff",
    "version": "1.0.0",
    "i18n": {
        "zh": {
            "strings": {
                "Dump Diff": "转储对比",
                "Mifare Classic": "Mifare Classic",
                "Ultralight/NTAG": "Ultralight/NTAG",
                "T5577": "T5577",
                "EM410x": "EM410x",
                "HID": "HID",
                "ISO15693": "ISO15693",
                "iClass": "iClass",
                "Back": "返回",
                "Compare": "对比",
                "Diff Result": "对比结果",
                "Again": "再次",
                "Diff Error": "对比错误"
            }
        }
    },
    "initial_state": "idle",
    "states": {
        "idle": {
            "screen": {
                "title": "Dump Diff",
                "content": {
                    "type": "list",
                    "style": "radio",
                    "page_size": 5,
                    "selected": 0,
                    "selected_var": "dump_type_key",
                    "selected_label_var": "dump_type",
                    "checked_by_selection": true,
                    "items": [
                        {"label": "Mifare Classic", "value": "mf1"},
                        {"label": "Ultralight/NTAG", "value": "mfu"},
                        {"label": "T5577", "value": "t55xx"},
                        {"label": "EM410x", "value": "em410x"},
                        {"label": "HID", "value": "hid"},
                        {"label": "ISO15693", "value": "icode"},
                        {"label": "iClass", "value": "iclass"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Compare"},
                "keys": {
                    "UP": "scroll:-1",
                    "DOWN": "scroll:1",
                    "M1": "finish",
                    "M2": "set_state:running",
                    "OK": "set_state:running"
                }
            }
        },
        "running": {
            "on_enter": "run:compare_latest",
            "screen": {
                "title": "Dump Diff",
                "content": {
                    "type": "progress",
                    "message": "{progress_message}",
                    "value": "{progress_value}",
                    "max": 100
                },
                "buttons": {"left": null, "right": null},
                "keys": {}
            },
            "transitions": {
                "on_result.status==done": "result",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "result": {
            "screen": {
                "title": "Diff Result",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "{result_text}", "size": "normal"}
                    ],
                    "scrollable": true
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "M1": "finish",
                    "M2": "set_state:idle",
                    "OK": "set_state:idle"
                }
            }
        },
        "error": {
            "screen": {
                "title": "Diff Error",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "{error_msg}", "size": "normal"}
                    ],
                    "scrollable": true
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "M1": "finish",
                    "M2": "set_state:idle",
                    "OK": "set_state:idle"
                }
            }
        }
    }
}
